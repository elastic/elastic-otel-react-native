{
  "name": "@elastic/otel-react-native",
  "version": "0.0.0",
  "description": "React Native bridge for EDOT Android and EDOT iOS",
  "license": "Apache-2.0",
  "homepage": "https://github.com/elastic/elastic-otel-react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/elastic-otel-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/elastic/elastic-otel-react-native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./src/index.ts"
    },
    "./babel-plugin": {
      "types": "./babel-plugin.d.cts",
      "default": "./babel-plugin.cjs"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "elastic-otel-react-native": "bin/elastic-otel-react-native.mjs"
  },
  "files": [
    "bin",
    "babel-plugin.cjs",
    "babel-plugin.d.cts",
    "app.plugin.js",
    "setup-edits.cjs",
    "docs",
    "src",
    "lib",
    "ElasticOtelReactNative.podspec",
    "elastic-otel-config.schema.json",
    "ios/Package.swift",
    "ios/Sources",
    "android/elastic-otel.gradle",
    "android/library/build.gradle",
    "android/library/gradle.properties",
    "android/library/src/main",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "NOTICE.txt"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "typecheck": "npm run tsc -- --noEmit",
    "build:types": "npm run tsc -- --emitDeclarationOnly",
    "prepare": "npm run build:types",
    "prepack": "npm run build:types",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "android:test": "cd android && ./gradlew :library:testDebugUnitTest :library:lintDebug",
    "ios:test": "node scripts/run-ios-native-tests.mjs",
    "setup:test": "node scripts/test-setup-android.mjs",
    "setup:ios:test": "node scripts/test-setup-ios.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "pack:check": "node scripts/validate-package-payload.mjs",
    "fixture:build": "npm --prefix build/external-fixture ci --no-audit --no-fund && cd build/external-fixture/android && ./gradlew :app:assembleDebug :app:assembleRelease",
    "fixture:ios:build": "node scripts/build-ios-fixture.mjs",
    "fixture:typecheck": "npm run tsc -- --project build/external-fixture/tsconfig.json --noEmit",
    "fixture:verify-autolinking": "node scripts/verify-fixture-autolinking.mjs",
    "validate:js-android": "npm run headers:check && npm run licenses:check && npm run format:check && npm run typecheck && npm run build:types && npm test && npm run android:test && npm run setup:test && npm run setup:ios:test && npm run fixture:typecheck && npm run docs:check && npm run pack:check && npm run fixture:build",
    "validate:ios": "npm run ios:test && npm run fixture:ios:build && npm run fixture:verify-autolinking",
    "validate:expo:android": "node scripts/expo-fixture.mjs build android",
    "validate:expo:ios": "node scripts/expo-fixture.mjs build ios",
    "validate:expo": "npm run validate:expo:android && npm run validate:expo:ios",
    "validate": "npm run validate:js-android && npm run validate:ios && npm run validate:expo",
    "test:expo-launch:android": "node scripts/expo-fixture.mjs launch android",
    "test:expo-launch:ios": "node scripts/expo-fixture.mjs launch ios",
    "headers:check": "node scripts/check-license-headers.mjs",
    "headers:fix": "node scripts/check-license-headers.mjs --fix",
    "notice:generate": "node scripts/generate-notice.mjs --generate",
    "licenses:check": "node scripts/generate-notice.mjs --check",
    "tsc": "node node_modules/typescript/bin/tsc"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.20.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "xcode": "^3.0.1"
  }
}
